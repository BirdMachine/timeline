# Copy to .env on the server. NEVER commit the real .env.

POSTGRES_DB=dawarich_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SECRET_KEY_BASE=CHANGE_ME_OPENSSL_RAND_HEX_64

# Public hostname only; no protocol or port.
APPLICATION_HOSTS=timeline.example.com
APPLICATION_PROTOCOL=https
TIME_ZONE=America/New_York

RAILS_ENV=production
SELF_HOSTED=true

# Pin deliberately after verifying the current release; avoid silently upgrading
# location infrastructure. Replace with a known-good version before first launch.
DAWARICH_IMAGE=freikin/dawarich:latest
